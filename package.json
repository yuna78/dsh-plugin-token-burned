{
  "name": "dsh-plugin-token-burned",
  "version": "0.3.0",
  "description": "DSH floating Token Burn Dock with live burn rate, seven animated burn tiers, and timezone-correct hourly usage views",
  "type": "module",
  "main": "./index.js",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "usage",
    "dashboard"
  ],
  "homepage": "https://github.com/yuna78/dsh-plugin-token-burned#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuna78/dsh-plugin-token-burned.git"
  },
  "bugs": {
    "url": "https://github.com/yuna78/dsh-plugin-token-burned/issues"
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/preview-real.webp",
    "docs/preview-tiers.webp",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node verify/smoke.mjs && node verify/baseline.mjs && node verify/tiers.mjs",
    "hours": "node verify/hours.mjs",
    "backfill": "node verify/backfill.mjs",
    "prepublishOnly": "node verify/smoke.mjs",
    "preview": "node verify/preview.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
